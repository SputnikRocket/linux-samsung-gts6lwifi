# Overrides merged on top of gts6lwifi_eur_open_defconfig:
#   make O=out ARCH=arm64 gts6lwifi_eur_open_defconfig gts6lwifi_custom.config
#
# Samsung's control-flow protection (JOPP/ROPP) needs Qualcomm's private clang;
# with AOSP clang scripts/rkp_cfp/instrument.py crashes, so keep it off.
# CONFIG_RKP_CFP is not set
# CONFIG_RKP_CFP_JOPP is not set
# CONFIG_RKP_CFP_ROPP is not set
CONFIG_LOCALVERSION="-ILIKEPIZZA"
